# =============================================================================
# NS3-Gazebo System - Git Ignore File
# Updated for NS-3 3.45 + Gazebo Harmonic + ROS2 Jazzy
# =============================================================================

# Python Files
# -------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Build Artifacts
# ----------------
build/
dist/
install/
log/
*.so
*.a
*.o
*.obj
*.exe
*.dll
*.dylib

# CMake Files
# -----------
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
CTestTestfile.cmake
_deps/

# NS-3 Specific
# -------------
# Exclude NS-3 build artifacts but keep source structure
ns-allinone-3.45/ns-3.45/build/
ns-allinone-3.45/ns-3.45/cmake-cache/
ns-allinone-3.45/ns-3.45/.lock-ns3_linux_build
*.pcap
*.tr
*.xml

# Gazebo Specific
# ---------------
.gazebo/
*.world~
*.sdf~

# ROS2 Specific
# -------------
install/
log/
build/
devel/
.catkin_workspace
*.bag

# IDE and Editor Files
# --------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary Files
